# Configuración del Entorno de El Arca Market

# Base de Datos MongoDB Atlas
MONGODB_URI="mongodb+srv://usuario:password@cluster.mongodb.net/el_arca_market?retryWrites=true&w=majority"
MONGODB_DB_NAME="el_arca_market"

# Seguridad y Autenticación JWT / Sesiones
JWT_SECRET="super-secreto-cambiar-en-produccion-minimo-32-caracteres"
NEXTAUTH_SECRET="super-secreto-nextauth-32-caracteres"
NEXTAUTH_URL="http://localhost:3000"

# Motor de Inteligencia Artificial (Gemini API / Vercel AI SDK)
AI_PROVIDER="google"
GOOGLE_GENERATIVE_AI_API_KEY="AIzaSyYourGeminiApiKeyHere"
AI_MODEL="gemini-1.5-flash"

# Proveedor Secundario Opcional (OpenAI)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Configuración Inicial de la Aplicación
NEXT_PUBLIC_APP_NAME="El Arca Market"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
